# ==============================================================
# 凭据模板
# 用法：把本文件复制为同目录下的 .env，然后按需填写
#       .env 已在 .gitignore 中，不会被提交
#
# 不填任何 key 也能跑：configs/models.yaml 里默认启用的是 mock 模型，
# 可以在完全离线的状态下验证整条评测流水线。
# ==============================================================

# 火山方舟（字节跳动）
ARK_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Moonshot Kimi
MOONSHOT_API_KEY=

# 阿里通义千问（DashScope OpenAI 兼容模式）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# OpenAI
OPENAI_API_KEY=
